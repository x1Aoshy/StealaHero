-- Server-side catch (GuardChaseService fires "Guards: ServerHit" { AreaId, GuardPosition, Force } to
-- the caught carrier). Character physics is client-owned, so the knockback runs here: the same
-- short-lived LinearVelocity the client guard runtimes use (a one-shot velocity would be overridden
-- by the Humanoid controller within a frame).
local SERVER_HIT_UPWARD_RATIO = 0.4
local SERVER_HIT_DURATION = 0.25
local SERVER_HIT_MAX_FORCE = 250.0

local function applyServerHitKnockback(payload)
	if type(payload) ~= "table" or typeof(payload.GuardPosition) ~= "Vector3" then
		return
	end

	local character = Players.LocalPlayer.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")

	if rootPart == nil or not rootPart:IsA("BasePart") then
		return
	end

	local force = math.clamp(tonumber(payload.Force) or 55.0, 0.0, SERVER_HIT_MAX_FORCE)
	local away = rootPart.Position - payload.GuardPosition
	away = Vector3.new(away.X, 0.0, away.Z)
	away = if away.Magnitude > 0.1 then away.Unit else rootPart.CFrame.LookVector * -1.0

	local attachment = Instance.new("Attachment")
	attachment.Name = "ServerGuardKnockbackAttachment"
	attachment.Parent = rootPart

	local linearVelocity = Instance.new("LinearVelocity")
	linearVelocity.Attachment0 = attachment
	linearVelocity.MaxForce = math.huge
	linearVelocity.VectorVelocity = away * force + Vector3.new(0.0, force * SERVER_HIT_UPWARD_RATIO, 0.0)
	linearVelocity.Parent = rootPart

	task.delay(SERVER_HIT_DURATION, function()
		linearVelocity:Destroy()
		attachment:Destroy()
	end)
end

