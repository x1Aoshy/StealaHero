-- StarterPlayer.StarterPlayerScripts.Game.VillainClipPlayer (LocalScript)
-- Owner 2026-09-27: "Frieza floats but has no float animation; each boss must have its own unique attack and run when
-- they chase you, and an idle as if they were distracted or asleep". Plays the stage villains' authored clips
-- (ReplicatedStorage.Directory.VillainAnimations.<Villain>, generated by scripts/tools/villain_anim/gen_villain_clips.py,
-- evaluated with ReplicatedStorage.Library.Modules.HeroClipMath) by writing each Motor6D.Transform of the rig in
-- RunService.PreRender, so no animation asset is uploaded and nothing else animates the joints: GuardChaseService loads
-- no Animator track for these villains (attribute ClientClips).
--
-- Driven by the replicated guard attributes:
--   GuardState Sleeping  -> Idle (loop; each villain's distracted / dozing idle at the post)
--              Waking    -> Wake (one-shot alert, holds its last pose)
--              Chasing   -> Move (the chase run; Frieza glides) while moving, else Idle
--              Returning / Retrieving -> Walk while moving, else Idle
--   ChaseFx "Punch;<seq>;..." -> Attack (one-shot overlay: the villain's own catch hit)
-- Cross-fades between states (FADE s). Move / Walk follow the ground speed (rate = speed / (clip Speed * RigScale)).
-- While the villain carries an egg home (local attribute ClipArmsHeld, set by Game.AreaEggs) its arm joints are left at
-- rest so the carry pose (Motor6D.C0) holds the egg.
-- Cost: full rate within NEAR_RANGE of the camera, MID_HZ up to FAR_RANGE, frozen beyond; no table is allocated per frame.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LOOKUP_TIMEOUT = 30
local FADE = 0.25
local ATTACK_IN = 0.06
local ATTACK_OUT = 0.16
local MOVING_SPEED = 1.5 -- studs/s of horizontal speed that counts as moving
local MIN_RATE, MAX_RATE = 0.6, 1.9
local NEAR_RANGE = 110
local FAR_RANGE = 260
local MID_HZ = 15

local JOINTS = {
	"Root", "Waist", "Neck", "LeftShoulder", "LeftElbow", "LeftWrist", "RightShoulder", "RightElbow", "RightWrist",
	"LeftHip", "LeftKnee", "LeftAnkle", "RightHip", "RightKnee", "RightAnkle",
}
local ARM_JOINTS = { LeftShoulder = true, LeftElbow = true, LeftWrist = true, RightShoulder = true, RightElbow = true, RightWrist = true }
local ALIASES = {
	thanos = "Thanos", darkseid = "Darkseid", carnage = "Carnage", shigaraki = "Shigaraki", frieza = "Frieza", freeza = "Frieza",
	kaido = "Kaido",
}
local BASE_CLIP = { Sleeping = "Idle", Waking = "Wake" }

local library = ReplicatedStorage:WaitForChild("Library", LOOKUP_TIMEOUT)
local modules = library and library:WaitForChild("Modules", LOOKUP_TIMEOUT)
local mathModule = modules and modules:WaitForChild("HeroClipMath", LOOKUP_TIMEOUT)
local directory = ReplicatedStorage:WaitForChild("Directory", LOOKUP_TIMEOUT)
local clipFolder = directory and directory:WaitForChild("VillainAnimations", LOOKUP_TIMEOUT)
if not (mathModule and clipFolder) then
	return
end
local HeroClipMath = require(mathModule)
local IDENTITY = HeroClipMath.Identity

local function villainKey(heroId)
	if type(heroId) ~= "string" then
		return nil
	end
	local normalized = string.lower((string.gsub(heroId, "[^%w]", "")))
	for alias, key in pairs(ALIASES) do
		if string.find(normalized, alias, 1, true) then
			return key
		end
	end
	return nil
end

local prepared = {} -- [villain key] = { [clip name] = Clip } | false
local function clipsFor(key)
	if prepared[key] == nil then
		local module = key and clipFolder:FindFirstChild(key)
		local ok, clips = false, nil
		if module and module:IsA("ModuleScript") then
			ok, clips = pcall(function()
				return HeroClipMath.PrepareModule(require(module))
			end)
		end
		prepared[key] = if ok then clips else false
	end
	return prepared[key] or nil
end

local function newPose()
	local pose = {}
	for _, joint in ipairs(JOINTS) do
		pose[joint] = table.create(7, 0)
	end
	return pose
end

local function resetPose(pose)
	for _, joint in ipairs(JOINTS) do
		local slot = pose[joint]
		slot[1], slot[2], slot[3], slot[4], slot[5], slot[6], slot[7] = 0, 0, 0, 1, 0, 0, 0
	end
end

local function copy(from, to)
	to[1], to[2], to[3], to[4], to[5], to[6], to[7] = from[1], from[2], from[3], from[4], from[5], from[6], from[7]
end

local entries = {} -- [guard Model] = entry

local function removeEntry(guard)
	local entry = entries[guard]
	if not entry then
		return
	end
	entries[guard] = nil
	for _, connection in ipairs(entry.connections) do
		connection:Disconnect()
	end
	for _, motor in pairs(entry.motors) do
		if motor.Parent then
			motor.Transform = CFrame.identity
		end
	end
end

local function onChaseFx(entry)
	local value = entry.guard:GetAttribute("ChaseFx")
	if type(value) ~= "string" then
		return
	end
	local fields = string.split(value, ";")
	local seq = tonumber(fields[2])
	if fields[1] == "Punch" and seq and seq > entry.lastFxSeq then
		entry.attackT = 0
	end
	if seq and seq > entry.lastFxSeq then
		entry.lastFxSeq = seq
	end
end

local function addEntry(guard)
	if entries[guard] or not guard:IsA("Model") then
		return
	end
	local clips = clipsFor(villainKey(guard:GetAttribute("HeroId")))
	local hrp = guard:FindFirstChild("HumanoidRootPart")
	if not (clips and hrp and hrp:IsA("BasePart")) then
		return
	end
	local motors = {}
	for _, d in ipairs(guard:GetDescendants()) do
		if d:IsA("Motor6D") and table.find(JOINTS, d.Name) and motors[d.Name] == nil then
			motors[d.Name] = d
		end
	end
	if motors.Root == nil or motors.Waist == nil then
		return
	end
	-- the stored fx sequence is where playback starts (an old Punch in the attribute does not replay on join)
	local initialSeq = 0
	local value = guard:GetAttribute("ChaseFx")
	if type(value) == "string" then
		initialSeq = tonumber(string.split(value, ";")[2]) or 0
	end
	local entry = {
		guard = guard,
		hrp = hrp,
		clips = clips,
		motors = motors,
		scale = tonumber(guard:GetAttribute("RigScale")) or 1,
		base = "Idle",
		baseT = math.random() * clips.Idle.Length, -- no two villains doze in sync
		prev = nil,
		prevT = 0,
		fade = 1,
		attackT = nil,
		lastFxSeq = initialSeq,
		accum = 0,
		poseBase = newPose(),
		posePrev = newPose(),
		poseAttack = newPose(),
		mix = newPose(),
		connections = {},
	}
	entries[guard] = entry
	table.insert(entry.connections, guard:GetAttributeChangedSignal("ChaseFx"):Connect(function()
		onChaseFx(entry)
	end))
	table.insert(entry.connections, guard:GetAttributeChangedSignal("RigScale"):Connect(function()
		entry.scale = tonumber(guard:GetAttribute("RigScale")) or 1
	end))
	table.insert(entry.connections, guard.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			removeEntry(guard)
		end
	end))
end

local function desiredClip(entry, speed)
	local state = entry.guard:GetAttribute("GuardState")
	local fixed = BASE_CLIP[state]
	if fixed then
		return fixed
	end
	if speed < MOVING_SPEED then
		return "Idle"
	end
	return if state == "Chasing" then "Move" else "Walk"
end

local function step(entry, dt)
	local clips = entry.clips
	local velocity = entry.hrp.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local want = desiredClip(entry, speed)
	if want ~= entry.base then
		entry.prev, entry.prevT = entry.base, entry.baseT
		entry.base = want
		entry.baseT = if want == "Idle" then math.random() * clips.Idle.Length else 0
		entry.fade = 0
	end
	local clip = clips[entry.base]
	local rate = 1
	if (entry.base == "Move" or entry.base == "Walk") and clip.Speed then
		rate = math.clamp(speed / (clip.Speed * entry.scale), MIN_RATE, MAX_RATE)
	end
	entry.baseT += dt * rate
	if not clip.Loop then
		entry.baseT = math.min(entry.baseT, clip.Length)
	end
	resetPose(entry.poseBase)
	HeroClipMath.SampleClip(clip, entry.baseT, entry.poseBase)

	local mix = entry.mix
	if entry.prev and entry.fade < 1 then
		entry.fade = math.min(1, entry.fade + dt / FADE)
		local prevClip = clips[entry.prev]
		entry.prevT += dt
		resetPose(entry.posePrev)
		HeroClipMath.SampleClip(prevClip, if prevClip.Loop then entry.prevT else math.min(entry.prevT, prevClip.Length), entry.posePrev)
		local w = entry.fade * entry.fade * (3 - 2 * entry.fade)
		for _, joint in ipairs(JOINTS) do
			HeroClipMath.Blend(entry.posePrev[joint], entry.poseBase[joint], w, mix[joint])
		end
	else
		entry.prev = nil
		for _, joint in ipairs(JOINTS) do
			copy(entry.poseBase[joint], mix[joint])
		end
	end

	if entry.attackT then
		local attack = clips.Attack
		entry.attackT += dt
		if entry.attackT >= attack.Length + ATTACK_OUT then
			entry.attackT = nil
		else
			local t = entry.attackT
			local w = if t < ATTACK_IN then t / ATTACK_IN elseif t > attack.Length then 1 - (t - attack.Length) / ATTACK_OUT else 1
			resetPose(entry.poseAttack)
			HeroClipMath.SampleClip(attack, math.min(t, attack.Length), entry.poseAttack)
			for _, joint in ipairs(JOINTS) do
				HeroClipMath.Blend(mix[joint], entry.poseAttack[joint], w, mix[joint])
			end
		end
	end

	local armsHeld = entry.guard:GetAttribute("ClipArmsHeld") == true
	local scale = entry.scale
	for joint, motor in pairs(entry.motors) do
		local sample = if armsHeld and ARM_JOINTS[joint] then IDENTITY else mix[joint]
		motor.Transform = HeroClipMath.ToCFrame(sample, scale)
	end
end

RunService.PreRender:Connect(function(dt)
	local camera = Workspace.CurrentCamera
	local eye = camera and camera.CFrame.Position
	for guard, entry in pairs(entries) do
		if not (guard.Parent and entry.hrp.Parent) then
			removeEntry(guard)
			continue
		end
		local distance = if eye then (entry.hrp.Position - eye).Magnitude else 0
		if distance > FAR_RANGE then
			entry.accum = 0
			continue
		end
		entry.accum += dt
		if distance > NEAR_RANGE and entry.accum < 1 / MID_HZ then
			continue
		end
		local elapsed = math.min(entry.accum, 0.25)
		entry.accum = 0
		local ok, err = pcall(step, entry, elapsed)
		if not ok then
			warn("[VillainClipPlayer] " .. guard:GetFullName() .. ": " .. tostring(err))
			removeEntry(guard)
		end
	end
end)

-- Guards: Workspace.__OBJECTS.Areas.GuardAreas.<zone>.Guard (the server may rebuild one: watch the zones)
local function watchZone(zone)
	local guard = zone:FindFirstChild("Guard")
	if guard then
		addEntry(guard)
	end
	zone.ChildAdded:Connect(function(child)
		if child.Name == "Guard" then
			task.defer(addEntry, child)
		end
	end)
end

task.spawn(function()
	local objects = Workspace:WaitForChild("__OBJECTS", LOOKUP_TIMEOUT)
	local areas = objects and objects:WaitForChild("Areas", LOOKUP_TIMEOUT)
	local guardAreas = areas and areas:WaitForChild("GuardAreas", LOOKUP_TIMEOUT)
	if not guardAreas then
		return
	end
	for _, zone in ipairs(guardAreas:GetChildren()) do
		watchZone(zone)
	end
	guardAreas.ChildAdded:Connect(watchZone)
end)
