-- ReplicatedStorage.Library.Modules.HeroClipMath (ANIMCORE, hero animation pipeline)
-- Pure evaluation math of the authored hero clips (ReplicatedStorage.Directory.HeroAnimations.<HeroId>, generated by
-- scripts/tools/blender/hero_anim/run.py). No services, no instances: HeroClipPlayer drives it at runtime and the
-- offline verifier (scripts/tools/verify_hero_anims.luau) loads this very file in Lune to prove the game poses the rig
-- exactly like Blender did.
--
-- Data (Format 1): Clips.<Name> = { Length, Loop, Speed?, Footsteps, Motion = { Lift, Lean }, Effects = {...},
--   Tracks = { <Motor6D name> = { { time, easing, qx, qy, qz, qw [, px, py, pz] }, ... } } }
-- A key's easing shapes the segment from that key to the next (Blender F-curve / Roblox Pose semantics). Between two
-- keys each quaternion / position component is lerped with the eased alpha and the quaternion is normalised: that is
-- what Blender does with quaternion channels, so both agree to float precision (no slerp on purpose).
-- The easing curves are Blender's (BLI_easing, Penner) and must stay in sync with scripts/tools/blender/hero_anim/rbx.py.

local HeroClipMath = {}

HeroClipMath.Format = 1

local BACK = 1.70158
local HALF_PI = math.pi * 0.5

local function bounceOut(t: number): number
	if t < 1 / 2.75 then
		return 7.5625 * t * t
	elseif t < 2 / 2.75 then
		t -= 1.5 / 2.75
		return 7.5625 * t * t + 0.75
	elseif t < 2.5 / 2.75 then
		t -= 2.25 / 2.75
		return 7.5625 * t * t + 0.9375
	end
	t -= 2.625 / 2.75
	return 7.5625 * t * t + 0.984375
end

local function inOut(fIn: (number) -> number, fOut: (number) -> number): (number) -> number
	return function(t: number): number
		if t < 0.5 then
			return fIn(t * 2) * 0.5
		end
		return fOut(t * 2 - 1) * 0.5 + 0.5
	end
end

local families = {
	sine = {
		function(t)
			return 1 - math.cos(t * HALF_PI)
		end,
		function(t)
			return math.sin(t * HALF_PI)
		end,
		function(t)
			return -0.5 * (math.cos(math.pi * t) - 1)
		end,
	},
	quad = {
		function(t)
			return t * t
		end,
		function(t)
			return -t * (t - 2)
		end,
	},
	cubic = {
		function(t)
			return t * t * t
		end,
		function(t)
			return (t - 1) ^ 3 + 1
		end,
	},
	quart = {
		function(t)
			return t ^ 4
		end,
		function(t)
			return -((t - 1) ^ 4 - 1)
		end,
	},
	quint = {
		function(t)
			return t ^ 5
		end,
		function(t)
			return (t - 1) ^ 5 + 1
		end,
	},
	circ = {
		function(t)
			return -(math.sqrt(math.max(0, 1 - t * t)) - 1)
		end,
		function(t)
			return math.sqrt(math.max(0, 1 - (t - 1) ^ 2))
		end,
	},
	back = {
		function(t)
			return t * t * ((BACK + 1) * t - BACK)
		end,
		function(t)
			t -= 1
			return t * t * ((BACK + 1) * t + BACK) + 1
		end,
		function(t)
			local s = BACK * 1.525
			t *= 2
			if t < 1 then
				return 0.5 * (t * t * ((s + 1) * t - s))
			end
			t -= 2
			return 0.5 * (t * t * ((s + 1) * t + s) + 2)
		end,
	},
	bounce = {
		function(t)
			return 1 - bounceOut(1 - t)
		end,
		bounceOut,
		function(t)
			if t < 0.5 then
				return (1 - bounceOut(1 - t * 2)) * 0.5
			end
			return bounceOut(t * 2 - 1) * 0.5 + 0.5
		end,
	},
}

-- name -> curve(t in 0..1) (same names as rbx.EASINGS)
local EASINGS: { [string]: (number) -> number } = {
	linear = function(t)
		return t
	end,
	constant = function(_)
		return 0
	end,
}
for family, curves in pairs(families) do
	EASINGS[family .. "_in"] = curves[1]
	EASINGS[family .. "_out"] = curves[2]
	EASINGS[family .. "_inout"] = curves[3] or inOut(curves[1], curves[2])
end
HeroClipMath.Easings = EASINGS

function HeroClipMath.Ease(name: string, t: number): number
	local curve = EASINGS[name] or EASINGS.linear
	return curve(math.clamp(t, 0, 1))
end

export type Track = {
	Joint: string,
	Times: { number },
	Curves: { (number) -> number },
	Constant: { boolean },
	Values: { { number } }, -- { qx, qy, qz, qw, px, py, pz }
	Cursor: number,
}

export type Clip = {
	Name: string,
	Length: number,
	Loop: boolean,
	Speed: number?,
	Footsteps: boolean,
	Lift: number,
	Lean: number,
	Effects: { any },
	Tracks: { Track },
}

local function fail(message: string)
	error("[HeroClipMath] " .. message, 3)
end

-- Validates one clip of a generated module and converts it for fast sampling. Errors on malformed data.
function HeroClipMath.PrepareClip(name: string, data: any): Clip
	if type(data) ~= "table" then
		fail(`clip { name } is not a table`)
	end
	local length = data.Length
	if type(length) ~= "number" or length <= 0 then
		fail(`clip { name }: Length must be > 0`)
	end
	if type(data.Tracks) ~= "table" then
		fail(`clip { name }: Tracks missing`)
	end
	local motion = type(data.Motion) == "table" and data.Motion or {}
	local clip: Clip = {
		Name = name,
		Length = length,
		Loop = data.Loop == true,
		Speed = if type(data.Speed) == "number" and data.Speed > 0 then data.Speed else nil,
		Footsteps = data.Footsteps ~= false,
		Lift = if type(motion.Lift) == "number" then motion.Lift else 1,
		Lean = if type(motion.Lean) == "number" then motion.Lean else 1,
		Effects = type(data.Effects) == "table" and data.Effects or {},
		Tracks = {},
	}
	for joint, keys in pairs(data.Tracks) do
		if type(joint) ~= "string" or type(keys) ~= "table" or #keys == 0 then
			fail(`clip { name }: bad track { tostring(joint) }`)
		end
		local track: Track = { Joint = joint, Times = {}, Curves = {}, Constant = {}, Values = {}, Cursor = 1 }
		local last = -math.huge
		for i, key in ipairs(keys) do
			local t = key[1]
			if type(t) ~= "number" or t < last or #key < 6 then
				fail(`clip { name }.{ joint }: key { i } malformed or out of order`)
			end
			last = t
			local easing = key[2]
			if type(easing) ~= "string" or EASINGS[easing] == nil then
				fail(`clip { name }.{ joint }: unknown easing { tostring(easing) }`)
			end
			track.Times[i] = t
			track.Curves[i] = EASINGS[easing]
			track.Constant[i] = easing == "constant"
			track.Values[i] = { key[3], key[4], key[5], key[6], key[7] or 0, key[8] or 0, key[9] or 0 }
		end
		table.insert(clip.Tracks, track)
	end
	return clip
end

-- Validates a whole generated module: returns { [clipName]: Clip } or errors.
function HeroClipMath.PrepareModule(data: any): { [string]: Clip }
	if type(data) ~= "table" or data.Format ~= HeroClipMath.Format or type(data.Clips) ~= "table" then
		fail("not a Format 1 hero animation module")
	end
	local clips = {}
	for name, clipData in pairs(data.Clips) do
		clips[name] = HeroClipMath.PrepareClip(name, clipData)
	end
	if clips.Idle == nil or clips.Move == nil or not clips.Idle.Loop or not clips.Move.Loop then
		fail("Idle and Move must exist and loop")
	end
	return clips
end

-- Wraps (loop) or clamps (one-shot) a clip time.
function HeroClipMath.ClipTime(clip: Clip, t: number): number
	if clip.Loop then
		t %= clip.Length
	end
	return math.clamp(t, 0, clip.Length)
end

-- One track at clip time t: qx, qy, qz, qw (normalised), px, py, pz. The cursor makes forward playback O(1).
function HeroClipMath.SampleTrack(track: Track, t: number): (number, number, number, number, number, number, number)
	local times, values = track.Times, track.Values
	local n = #times
	if n == 1 or t <= times[1] then
		local v = values[1]
		return v[1], v[2], v[3], v[4], v[5], v[6], v[7]
	end
	if t >= times[n] then
		local v = values[n]
		return v[1], v[2], v[3], v[4], v[5], v[6], v[7]
	end
	local i = track.Cursor
	if i >= n or times[i] > t then
		i = 1
	end
	while times[i + 1] <= t do
		i += 1
	end
	track.Cursor = i
	local a, b = values[i], values[i + 1]
	local span = times[i + 1] - times[i]
	local alpha = 0
	if not track.Constant[i] and span > 1e-9 then
		alpha = track.Curves[i]((t - times[i]) / span)
	end
	local qx = a[1] + (b[1] - a[1]) * alpha
	local qy = a[2] + (b[2] - a[2]) * alpha
	local qz = a[3] + (b[3] - a[3]) * alpha
	local qw = a[4] + (b[4] - a[4]) * alpha
	local m = math.sqrt(qx * qx + qy * qy + qz * qz + qw * qw)
	if m < 1e-9 then
		qx, qy, qz, qw, m = 0, 0, 0, 1, 1
	end
	return qx / m, qy / m, qz / m, qw / m, a[5] + (b[5] - a[5]) * alpha, a[6] + (b[6] - a[6]) * alpha, a[7] + (b[7] - a[7]) * alpha
end

-- Samples every track of a clip at clip time t into out[joint] = { qx, qy, qz, qw, px, py, pz } (reused tables).
-- Joints without a track are not written (they rest at identity).
function HeroClipMath.SampleClip(clip: Clip, t: number, out: { [string]: { number } })
	t = HeroClipMath.ClipTime(clip, t)
	for _, track in ipairs(clip.Tracks) do
		local slot = out[track.Joint]
		if slot == nil then
			slot = table.create(7, 0)
			out[track.Joint] = slot
		end
		slot[1], slot[2], slot[3], slot[4], slot[5], slot[6], slot[7] = HeroClipMath.SampleTrack(track, t)
	end
end

local IDENTITY = { 0, 0, 0, 1, 0, 0, 0 }
HeroClipMath.Identity = IDENTITY

-- Blends b into a with weight w (0 = a, 1 = b): shortest-arc quaternion nlerp + position lerp, written to out.
function HeroClipMath.Blend(a: { number }?, b: { number }?, w: number, out: { number })
	a = a or IDENTITY
	b = b or IDENTITY
	local ax, ay, az, aw = a[1], a[2], a[3], a[4]
	local bx, by, bz, bw = b[1], b[2], b[3], b[4]
	if ax * bx + ay * by + az * bz + aw * bw < 0 then
		bx, by, bz, bw = -bx, -by, -bz, -bw
	end
	local qx = ax + (bx - ax) * w
	local qy = ay + (by - ay) * w
	local qz = az + (bz - az) * w
	local qw = aw + (bw - aw) * w
	local m = math.sqrt(qx * qx + qy * qy + qz * qz + qw * qw)
	if m < 1e-9 then
		qx, qy, qz, qw, m = 0, 0, 0, 1, 1
	end
	out[1], out[2], out[3], out[4] = qx / m, qy / m, qz / m, qw / m
	out[5] = a[5] + (b[5] - a[5]) * w
	out[6] = a[6] + (b[6] - a[6]) * w
	out[7] = a[7] + (b[7] - a[7]) * w
end

-- The Motor6D.Transform of a sample; positions are multiplied by `scale` (rendered rig size / template size).
function HeroClipMath.ToCFrame(s: { number }, scale: number): CFrame
	return CFrame.new(s[5] * scale, s[6] * scale, s[7] * scale, s[1], s[2], s[3], s[4])
end

return HeroClipMath
