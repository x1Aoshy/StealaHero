				t1.min[k] = math.min(t1.min[k] or 1e999, p102[i][j][k])
				table.insert(t1.vertices, p102[i][j][k])
			end
		end

		if i > 1.0 then
			n13 += #p102[i - 1.0]
			table.insert(t1.holes, n13)
		end
	end

	return t1
end

return (setmetatable({
	Deviation = deviation,
	Flatten = flatten
}, {
	__call = function(_, ...) -- line: 850
		return earcut(...)
	end
}))

