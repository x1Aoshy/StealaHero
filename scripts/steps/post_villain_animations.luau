--!nocheck
-- scripts/steps/post_villain_animations.luau (owner 2026-09-27: "Frieza floats but has no float animation; each boss its
-- own unique attack and run when they chase you, and an idle as if distracted or asleep")
-- Publishes every src/ReplicatedStorage/Directory/VillainAnimations/<Villain>.luau (generated by
-- scripts/tools/villain_anim/gen_villain_clips.py, hero clip Format 1) as ReplicatedStorage.Directory.VillainAnimations
-- .<Villain> after validating it with the game's own ReplicatedStorage.Library.Modules.HeroClipMath (PrepareModule:
-- Idle and Move loop, keys ordered, easings known) and the clip set VillainClipPlayer plays (Idle, Wake, Move, Walk,
-- Attack). GuardChaseService loads no Animator track for a villain that has a module here (ClientClips).

local roblox = require("@lune/roblox")
local fs = require("@lune/fs")
local luau = require("@lune/luau")

local Instance = roblox.Instance

local Step = {}

Step.SOURCE_DIR = "src/ReplicatedStorage/Directory/VillainAnimations"
Step.CLIP_MATH = "src/ReplicatedStorage/Library/Modules/HeroClipMath.luau"
Step.CLIPS = { "Idle", "Wake", "Move", "Walk", "Attack" }

local function load(path, env)
	return luau.load(fs.readFile(path), { debugName = path, environment = env, injectGlobals = false })()
end

function Step.Apply(place, _spPlace, _ctx)
	local directory = place:GetService("ReplicatedStorage"):FindFirstChild("Directory")
	assert(directory ~= nil, "ReplicatedStorage.Directory missing")
	local clipMath = load(Step.CLIP_MATH, { math = math, table = table, string = string, type = type, pairs = pairs, ipairs = ipairs,
		error = error, tostring = tostring, tonumber = tonumber, setmetatable = setmetatable, CFrame = roblox.CFrame })

	local folder = directory:FindFirstChild("VillainAnimations")
	if folder then
		folder:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "VillainAnimations"
	folder.Parent = directory

	local published, errors = {}, {}
	local files = if fs.isDir(Step.SOURCE_DIR) then fs.readDir(Step.SOURCE_DIR) else {}
	table.sort(files)
	for _, fileName in ipairs(files) do
		if string.sub(fileName, -5) ~= ".luau" then
			continue
		end
		local name = string.sub(fileName, 1, -6)
		local path = Step.SOURCE_DIR .. "/" .. fileName
		local ok, result = pcall(function()
			local data = load(path, {})
			local clips = clipMath.PrepareModule(data)
			for _, clipName in ipairs(Step.CLIPS) do
				assert(clips[clipName] ~= nil, "clip " .. clipName .. " missing")
			end
			assert(not clips.Attack.Loop and not clips.Wake.Loop and clips.Walk.Loop, "Attack / Wake must be one-shots, Walk a loop")
			return data
		end)
		if not ok then
			table.insert(errors, path .. ": " .. tostring(result))
			continue
		end
		local module = Instance.new("ModuleScript")
		module.Name = name
		module.Source = fs.readFile(path)
		module.Parent = folder
		table.insert(published, name)
	end
	if #errors > 0 then
		error("[post_villain_animations] invalid villain clip module(s):\n  " .. table.concat(errors, "\n  "))
	end
	print(string.format("[post_villain_animations] %d villain clip module(s): %s", #published, table.concat(published, ", ")))
end

return Step
